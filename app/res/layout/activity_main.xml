<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="妙音工坊"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edge Neural · 文字转语音 · 16 种真人级音色"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="24dp">

            <!-- 输入卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 输入文字"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_second" />

                <EditText
                    android:id="@+id/input_text"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="10dp"
                    android:gravity="top|start"
                    android:hint="输入要转换成语音的文字，逗号、句号、问号都会自动停顿…"
                    android:textSize="16sp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_faint"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:inputType="textMultiLine" />

                <TextView
                    android:id="@+id/btn_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:padding="4dp"
                    android:text="清空 ✕"
                    android:textSize="12sp"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <!-- 音色选择卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙 选择音色"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_second" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/voice_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 语速卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/rate_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="语速  0%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_second" />

                <SeekBar
                    android:id="@+id/rate_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="20"
                    android:progress="10" />
            </LinearLayout>

            <!-- Fish Audio 引擎卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🐟 Fish Audio 引擎（莫提斯音色）"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_second" />

                    <Switch
                        android:id="@+id/fish_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <EditText
                    android:id="@+id/fish_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="API Key（fish.audio → 设置 → API Keys 生成）"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_faint"
                    android:background="@drawable/input_bg"
                    android:padding="10dp"
                    android:inputType="text"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/fish_voice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="音色 ID（莫提斯音色详情页获取）"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_faint"
                    android:background="@drawable/input_bg"
                    android:padding="10dp"
                    android:inputType="text"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💡 免费模型 s2.1-pro-free（$0）· 使用时需挂 VPN · 开关开启后合成走莫提斯音色"
                    android:textSize="11sp"
                    android:textColor="@color/text_faint" />
            </LinearLayout>

            <!-- 合成按钮 -->
            <Button
                android:id="@+id/btn_synthesize"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_gradient"
                android:text="✨ 合成并播放"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:elevation="4dp" />

            <TextView
                android:id="@+id/btn_local"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:padding="6dp"
                android:text="🔌 本地离线合成（不联网）"
                android:textSize="12sp"
                android:textColor="@color/text_dim" />

            <!-- 播放卡片 -->
            <LinearLayout
                android:id="@+id/player_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="还没有合成音频"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="输入文字后点击上方按钮开始合成"
                    android:textSize="12sp"
                    android:textColor="@color/text_dim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_play"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_ghost"
                        android:text="▶ 播放 / 暂停"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:enabled="false"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btn_save"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/btn_ghost"
                        android:text="💾 保存到下载"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:enabled="false"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- 历史记录 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="📜 最近合成（点击播放 · 长按删除）"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_second" />

            <ListView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@color/divider"
                android:dividerHeight="1dp"
                android:background="@drawable/card_bg"
                android:padding="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
